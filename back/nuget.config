<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <packageSources>
     <add key="greenCityNugets" value="https://gitlab.com/api/v4/projects/34251911/packages/nuget/index.json" />
 </packageSources>
 <!-- Учётные данные фида не хранятся в репозитории: NuGet подставляет их из переменных окружения
      GREENCITY_NUGET_USER и GREENCITY_NUGET_TOKEN (в Docker — через build args с теми же именами). -->
 <packageSourceCredentials>
     <greenCityNugets>
         <add key="Username" value="%GREENCITY_NUGET_USER%" />
         <add key="ClearTextPassword" value="%GREENCITY_NUGET_TOKEN%" />
     </greenCityNugets>
 </packageSourceCredentials>
</configuration>
